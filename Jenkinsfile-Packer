pipeline {
    agent any
    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'eu-west-1'
    }
    stages {
        stage('Validate Packer') {
            steps {
                dir('packer') {
                    sh 'packer init .'
                    sh 'packer validate aws-nginx-git-java.pkr.hcl'
                }
            }
        }
        stage('Build AMIs') {
            steps {
                dir('packer') {
                    // Use -force to overwrite if the name already exists
                    sh 'packer build -force aws-nginx-git-java.pkr.hcl'
                }
            }
        }
    }
}
