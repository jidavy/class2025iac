pipeline {
    agent any
    
    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'eu-west-1'
    }

    stages {
        stage('Initialize & Validate') {
            steps {
                dir('packer') {
                    // Downloads required plugins
                    sh 'packer init .' 
                    // Checks for syntax errors
                    sh 'packer validate aws-nginx-git-java.pkr.hcl'
                }
            }
        }

        stage('Build AMIs') {
            steps {
                dir('packer') {
                    // Builds both Nginx and Java/Python AMIs in parallel (if configured)
                    sh 'packer build -force aws-nginx-git-java.pkr.hcl'
                }
            }
        }
    }

    post {
        success {
            echo "AMIs created successfully! You can now run the Terraform pipeline."
        }
        failure {
            echo "Packer build failed. Check the logs for SSH or AWS permission issues."
        }
    }
}
